# ============================================================
# Anexo Risk — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
# ============================================================

# Database
DATABASE_URL=sqlite:///./anexo_risk.db
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# External APIs
GDACS_API_URL=https://www.gdacs.org/xml/rss.xml
GDACS_CACHE_TTL_SECONDS=900
PROTECCION_CIVIL_API_URL=

# NASA FIRMS — satellite fire detection
# Get your key at: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=
NASA_FIRMS_CACHE_TTL_SECONDS=3600

# AEMET — official Spain weather (fallback to Open-Meteo if not set)
AEMET_API_KEY=

# ============================================================
# REQUIRED — Authentication & Security
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANEXO_ADMIN_KEY=

# ============================================================
# Email (Volunteer management)
# ============================================================
ADMIN_EMAIL=admin@anexo-risk-local.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=anexo@risk-local.local
SMTP_PASSWORD=
EMAIL_DUMMY_MODE=true

# ============================================================
# Application
# ============================================================
BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads/voluntarios
MAX_UPLOAD_SIZE_MB=5

# ============================================================
# GeoData Engine (optional overrides)
# ============================================================
# USGS_CACHE_TTL_SECONDS=900
# IBTRACS_CACHE_TTL_SECONDS=3600
# SMITHSONIAN_CACHE_TTL_SECONDS=86400
# H3_DEFAULT_RESOLUTION=7

# ============================================================
# Risk Engine weights (optional overrides)
# ============================================================
# RISK_ENGINE_SEVERITY_WEIGHT=0.30
# RISK_ENGINE_EXPOSURE_WEIGHT=0.25
# RISK_ENGINE_WEATHER_WEIGHT=0.15
# RISK_ENGINE_DENSITY_WEIGHT=0.15
# RISK_ENGINE_NEEDS_WEIGHT=0.10
# RISK_ENGINE_TREND_WEIGHT=0.05
