# ============================================================
# Anexo Risk — Pilot Environment Configuration
# ============================================================
# Use this for pilot deployments.
# Copy to .env and fill in real values.
# ============================================================

# Database
DATABASE_URL=sqlite:///./anexo_risk.db
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Pilot mode flag (disables rate limiting for testing)
TESTING=false

# External APIs
GDACS_API_URL=https://www.gdacs.org/xml/rss.xml
GDACS_CACHE_TTL_SECONDS=900

# NASA FIRMS
NASA_FIRMS_API_KEY=
NASA_FIRMS_CACHE_TTL_SECONDS=3600

# Authentication — GENERATE REAL VALUES BEFORE DEPLOYING
JWT_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
ANEXO_ADMIN_KEY=CHANGE_ME_BEFORE_DEPLOY

# Application
BASE_URL=http://localhost:8080

# GeoRisk (optional)
# GEORISK_BASE_URL=http://localhost:8000

# Risk Engine (defaults are fine for pilot)
# RISK_ENGINE_SEVERITY_WEIGHT=0.30
